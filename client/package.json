{
  "name": "dino-roguelite",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "balance": "node --experimental-strip-types --no-warnings tools/balance/sim.ts",
    "balance:antes": "node --experimental-strip-types --no-warnings tools/balance/sim.ts --antes",
    "balance:carreira": "node --experimental-strip-types --no-warnings tools/balance/sim.ts 40 --carreira",
    "test:boss": "node --experimental-transform-types --no-warnings --import ./tools/balance/loader/register.mjs tools/balance/boss-test.ts",
    "test:endless": "node --experimental-transform-types --no-warnings --import ./tools/balance/loader/register.mjs tools/balance/endless-test.ts",
    "test:save": "node --experimental-transform-types --no-warnings --import ./tools/balance/loader/register.mjs tools/balance/save-test.ts",
    "test": "npm run test:boss && npm run test:endless && npm run test:save"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
